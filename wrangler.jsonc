{
  "name": "beccami",
  "main": "src/index.js",
  "compatibility_date": "2026-03-01",

  // Sito statico (cartella public). Le rotte /api/* e /ws passano dal Worker.
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*", "/ws", "/ws-stanza"]
  },

  // Database D1: sostituisci l'ID con quello del tuo database "beccami".
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "beccami",
      "database_id": "370bbb90-b14f-4eca-b3be-4e9cb64a9c22",
      "migrations_dir": "migrations"
    }
  ],

  // Server delle chat in tempo reale (Durable Object).
  "durable_objects": {
    "bindings": [
      { "name": "LOBBY", "class_name": "Lobby" },
      { "name": "STANZA", "class_name": "Stanza" }
    ]
  },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["Lobby"] },
    { "tag": "v2", "new_sqlite_classes": ["Stanza"] }
  ],

  // Impostazioni non segrete. I SEGRETI (chiavi) si inseriscono dalla dashboard Cloudflare.
  "vars": {
    "N8N_URL": "https://n8n.rosscoding.com",
    // "1" = registrazione Premium gratuita per fare prove. Metti "0" prima di aprire al pubblico.
    "MODALITA_PROVA": "0",
    "STRIPE_PRICE_PREMIUM": "price_1UVWfCFQUCc07ictmrtQli5i",
    "STRIPE_PRICE_CONTRIBUTORE": "price_1UVWgUFQUCc07ictqw8GwYNj",
    "STRIPE_PRICE_SBLOCCO": "price_1UVWi4FQUCc07ictDmmQTmMQ",
    "TURN_KEY_ID": "8a940e34edacacf6497bd27a3201626b"
  }
}
